_reload_rules() {
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=hidraw || true
  fi
}

post_install() {
  _reload_rules
  cat <<'EOF'
shurectl: unplug the Shure device and plug it back in so the udev rule applies.
EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  _reload_rules
}
